oka# ReScrap API Environment Variables

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000

# Secret key used to sign JWT session tokens (min 16 chars)
RESCRAP_JWT_SECRET=your-secure-random-jwt-secret-key-32-chars-long

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=https://your-collector-app.vercel.app,https://your-recycler-web.vercel.app,https://your-admin-web.vercel.app

# OTP Delivery mode (console for simulated demo, disabled to turn off logs)
RESCRAP_OTP_DELIVERY=console

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
