{
  "name": "rescrap",
  "version": "0.1.0",
  "private": true,
  "description": "ReScrap - digital platform connecting informal e-waste collectors with authorized recyclers",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r --no-bail run test",
    "build": "pnpm -r --no-bail run build",
    "lint": "pnpm -r --no-bail run lint",
    "dev": "pnpm --parallel --filter @rescrap/api --filter @rescrap/admin-web run dev",
    "dev:api": "pnpm --filter @rescrap/api dev",
    "dev:recycler": "pnpm --filter @rescrap/recycler-web dev",
    "dev:admin": "pnpm --filter @rescrap/admin-web dev",
    "dev:collector": "pnpm --filter @rescrap/collector start",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
