# ReScrap environment configuration
# Copy to .env and fill in. NEVER commit real secrets.

# Which data source the frontends use: "demo" or "api"
# Per technical-approach.md 3.2 - demo and api satisfy the identical ServiceInterface.
RESCRAP_DATA_SOURCE=demo

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development

# Access/refresh token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Development-only fallback secret. MUST be replaced in production (Phase 6).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RESCRAP_JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production

# Set to "console" to log OTP codes in development. Any other value disables logging.
RESCRAP_OTP_DELIVERY=console

# ---- Frontend API base URLs ----
REACT_APP_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---- Deferred to Phase 6 (system-architecture.md 17) ----
# DATABASE_URL=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# SMS_PROVIDER_API_KEY=
